rules_version = '2';
service firebase.storage {
 match /b/{bucket}/o {
  function signedIn() { return request.auth != null; }
  function owner(id) { return signedIn() && request.auth.uid == id; }
  function shared(id) {
   return signedIn() && request.auth.token.email_verified == true
     && firestore.get(/databases/(default)/documents/workspaces/$(id)).data.members.get(request.auth.token.email, 'none') in ['editor', 'viewer'];
  }
  function canRead(id) { return owner(id) || shared(id); }
  function canWrite(id) {
   return owner(id) ||
    (signedIn() && request.auth.token.email_verified == true
    && firestore.get(/databases/(default)/documents/workspaces/$(id)).data.members.get(request.auth.token.email, 'none') == 'editor');
  }
  match /workspaces/{workspaceId}/attachments/{attachmentId} {
   allow read: if canRead(workspaceId);
   allow write: if canWrite(workspaceId)
    && request.resource.size < 25 * 1024 * 1024
    && attachmentId.size() > 0 && attachmentId.size() < 120;
   allow delete: if owner(workspaceId);
  }
 }
}